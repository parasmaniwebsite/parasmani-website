<!--
  Static sitemap for the Parasmani marketing site.

  Kept in sync by hand with the <Route> list in src/App.jsx. When you add a
  public route there, add it here too.

  Entries are ordered by <priority>, highest first, and grouped by tier rather
  than by section. Crawlers do not care about document order — this is for
  whoever opens the file next.

  Priority tiers (client's stated ranking):
    1.0  home
    0.9  downloads
    0.8  tools
    0.7  medical gas
    0.6  pancake coils, contact, blogs
    0.5  remaining products and industries
    0.4  company pages and individual calculators
    0.3  legal

  Note that Google ignores <priority> and <changefreq> outright — it decides
  crawl order itself. They are kept because they cost nothing, other crawlers
  have historically read them, and the ranking documents intent.

  `lastmod` is when the page's content changed, not when this file was edited.
  Do not bump it for a priority change: it is the one hint here Google does
  use, and touching every date at once tells it nothing.

  Deliberately excluded:
    /admin/*          — CMS, noindex via the X-Robots-Tag header in
                        vercel.json. Deliberately NOT disallowed in robots.txt,
                        which would block the fetch that reads that header.
    /blog/:id         — dynamic, ids come from the backend at runtime
    /copper-estimator — duplicate route for the same component as
                        /project-estimator; only the canonical one is listed
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:video="http://www.google.com/schemas/sitemap-video/1.1">

  <!-- ── 1.0 ────────────────────────────────────────────────────────────
    <video:video> entries mirror the VideoObject markup in src/seo/schema.js.
    Both must agree: title, description, thumbnail and content URL are checked
    against the page, and a mismatch gets the entry dropped rather than merged.

    The files sit at fixed /videos/ paths in public/ precisely so they can be
    named here — a Vite-bundled asset carries a content hash that changes on
    re-encode and cannot be written into a static sitemap.
  -->
  <url>
    <loc>https://www.parasmanicopper.com/</loc>
    <lastmod>2026-08-04</lastmod>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
    <video:video>
      <video:thumbnail_loc>https://www.parasmanicopper.com/videos/copper-product-range-poster.jpg</video:thumbnail_loc>
      <video:title>Parasmani copper tube, coil and fitting range</video:title>
      <video:description>Product animation showing the Parasmani range: a soft annealed pancake copper coil, wrought copper fittings including elbows, tees, couplers and U-bends, and seamless straight copper tube.</video:description>
      <video:content_loc>https://www.parasmanicopper.com/videos/copper-product-range.mp4</video:content_loc>
      <video:duration>10</video:duration>
      <video:publication_date>2026-08-01</video:publication_date>
      <video:family_friendly>yes</video:family_friendly>
      <video:live>no</video:live>
    </video:video>
    <video:video>
      <video:thumbnail_loc>https://www.parasmanicopper.com/videos/copper-foundry-poster.jpg</video:thumbnail_loc>
      <video:title>Copper melting and casting at the Parasmani foundry</video:title>
      <video:description>Footage from the Parasmani plant in Umbergaon, Gujarat: molten copper being poured during casting, the first stage in producing seamless copper tube.</video:description>
      <video:content_loc>https://www.parasmanicopper.com/videos/copper-foundry.mp4</video:content_loc>
      <video:duration>8</video:duration>
      <video:publication_date>2026-05-16</video:publication_date>
      <video:family_friendly>yes</video:family_friendly>
      <video:live>no</video:live>
    </video:video>
  </url>

  <!-- ── 0.9 — Downloads ────────────────────────────────────────────────
    /downloads?category=... are filtered views of this one page and canonicalise
    back to it, so only the bare path is listed.
  -->
  <url>
