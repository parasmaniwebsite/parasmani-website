# Backend Environment Variables
# Copy this file to .env and fill in the values

# Server Configuration
PORT=9000

# Number of reverse proxies in front of the app (nginx, Vercel, etc).
# Leave unset when the app is exposed directly. Required for correct
# IP-based rate limiting when it is not.
# TRUST_PROXY=1

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/paras-mani

# JWT Configuration
JWT_SECRET=parasmani_secret

# Optional: For production, change these to more secure values
# Example strong JWT_SECRET: your-long-random-string-here-min-32-chars

# First Admin (created on boot by src/utils/createSuperAdmin.js)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@parasmanicopper.com
ADMIN_PASSWORD=change-this-before-deploying

# ImageKit (blog image uploads — all three are required)
# Dashboard > Developer options > API keys
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Resend (password reset emails)
# API key: https://resend.com/api-keys
RESEND_API_KEY=

# Sender address. onboarding@resend.dev is Resend's sandbox and only delivers
# to the account that owns the API key — set a verified domain for production.
MAIL_FROM=onboarding@resend.dev

# Display name used in outgoing email
APP_NAME=Parasmani Copper
